{
  "name": "bekbekei-backend",
  "version": "0.1.0",
  "description": "Бэкенд доставки продуктов Бекбекей",
  "scripts": {
    "dev": "node --import tsx --watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "node --import tsx src/scripts/migrate.ts",
    "seed": "node --import tsx src/scripts/seed.ts",
    "seed:catalog": "node --import tsx src/scripts/seed-catalog.ts",
    "bootstrap": "node --import tsx src/scripts/bootstrap.ts",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "BB",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
